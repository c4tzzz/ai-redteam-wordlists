# Copy values from this file into your shell, not into a committed .env.
# Only evaluate models and endpoints you own or are explicitly authorized to test.

# Local Ollama OpenAI-compatible endpoint.
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=ollama
OPENAI_COMPAT_MODEL=llama3.2:3b

# LM Studio default local server.
# OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPAT_API_KEY=lm-studio
# OPENAI_COMPAT_MODEL=your-loaded-model

# vLLM OpenAI-compatible server.
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_API_KEY=local
# OPENAI_COMPAT_MODEL=your-served-model

# Hosted OpenAI-compatible endpoint.
# OPENAI_COMPAT_BASE_URL=https://your-authorized-endpoint.example/v1
# OPENAI_COMPAT_API_KEY=replace-in-your-shell-only
# OPENAI_COMPAT_MODEL=your-authorized-model
